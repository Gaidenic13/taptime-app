{
  "appId": "com.taptime.app",
  "appName": "TapTime",
  "webDir": "dist",
  "backgroundColor": "#e7e1dd",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#e7e1dd"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 400,
      "backgroundColor": "#e7e1dd",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    }
  }
}